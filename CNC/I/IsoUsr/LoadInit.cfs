: LoadInit

; Semi-Loader Part 1: Park all components, allow the operator to load the pipe (Optional)

DBL Debug_Loader = 0
IF( %cn[WHO()].rc[0].21 ) RET

SYN
; %ServiceMillePGM.12 : All Supports Z To Follow Position
; %ServiceMillePGM.13 : All Supports L To Follow
; %ServiceMillePGM.14 : All Centerings To Follow
IF( (%ServiceMillePGM.12) || (%ServiceMillePGM.13) || (%ServiceMillePGM.14) ) RET

IF( SelfLockSLoader == 0 ) THEN
    SYN	   
	;Page Pop Plc Command
    ?%LsGui71.4 = 1
    MSGOUT" Please select the mode to continue "
    AWAIT((%LsGui71.2) || (%LsGui71.3))
    SYN
    MSGOUT""
	
    IF( %LsGui71.2 ) THEN 
	    IF( Debug_Loader ) M0

        M464                ; extend tube detector mounted on top of the 1st spindle
        ;I_I_TubeDetector_Out                AT  %USR_M49.20;
        AWAIT(%USR_M49.20)
        
        ; I_I_TubeMobile_Spindle      AT  %USR_M1.27;
        ; I_I_TubeFix_Spindle         AT  %USR_M1.28;
		IF( (%USR_M1.27) || (%USR_M1.28)) THEN 


            .FAULT_STATE_LOADER_0
            SYN 
            MSGOUT " Tube Already Exist in Machine "	   
	        M0
            JMP .FAULT_STATE_LOADER_0	   		   
        ENDIF

        M465                    ; retract sensor to preven collisions
        ;I_I_TubeDetector_In                 AT  %USR_M49.21;
        AWAIT(%USR_M49.21)   
            
		%PROG_ONE.values11 = 0
	ENDIF

    IF( %LsGui71.3 ) THEN         
	    LstBreakPoint = %PROG_ONE.values11
	ENDIF
		   		   
    SYN
    ?%LsGui71.2 = 0
    ?%LsGui71.3 = 0
    ?%LsGui71.4 = 0
ENDIF

IF( LstBreakPoint != 0 ) RET

; Park all loader supports

; Here needs to check also if tube exsists signals ------------------->


MSGOUT " Parking vertical supports "
IF ( Debug_Loader ) M0

; ParkAllLoadSuppCmd AT %SUPPORTS_SYSTEM.values13.5;
?%SUPPORTS_SYSTEM.values13.5 = 1  


M725                ; Supports down command in automatic mode
SYN
; I_I_Support_1_Dwn   AT  %USR_M0.13;   ; Piston support down
; I_I_Support_2_Dwn   AT  %USR_M0.14;   ; Piston support down
; I_I_Support_3_Dwn   AT  %USR_M0.15;   ; Piston support down
; I_I_Support_4_Dwn   AT  %USR_M0.16;   ; Piston support down
WAITBIT("%USR_M0.13",1)
WAITBIT("%USR_M0.14",1)
WAITBIT("%USR_M0.15",1)
WAITBIT("%USR_M0.16",1)

SYN

M455                ; Close centerings (v-shapes down)
SYN
; I_I_VshapeZ1_Dwn AT  %USR_M49.4;
; I_I_VshapeZ2_Dwn AT  %USR_M49.5;
; I_I_VshapeZ3_Dwn AT  %USR_M49.6;
; I_I_VshapeZ4_Dwn AT  %USR_M49.7;
WAITBIT("%USR_M49.4",1)
WAITBIT("%USR_M49.5",1)
WAITBIT("%USR_M49.6",1)
WAITBIT("%USR_M49.7",1)



SYN
; ParkingPositionLoad      AT %LOADER.values15;
AWAIT( ABS((%ax51.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
AWAIT( ABS((%ax52.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
AWAIT( ABS((%ax53.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
AWAIT( ABS((%ax54.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )


MSGOUT " Parking horizontal supports "
IF ( Debug_Loader ) M0

?%SUPPORTS_SYSTEM.values13.5 = 0        ; Reset here in order for the SUPx.yReqGrant
                                        ; to reset and allow the movement of the  
                                        ; horizontal supports

SYN
; ParkingPosLoad_lat       AT %LOADER.values16;
AWAIT( ABS((%ax81.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
AWAIT( ABS((%ax82.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
AWAIT( ABS((%ax83.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
AWAIT( ABS((%ax84.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )

SelfLockSLoader = 1

RET
