: LoadTube

; Load Tube Automomatically 
DBL Debug_LoadTube = 1

DBL Vout0 = 0x04
DBL VOUT = 0x08
DBL Vmax = 0x10
DBL VHIGH = 5000
DBL VLOW  = 1000

DBL ax30CurrPos               ; auxiliary varaible to hold the 1st spindle current position
DBL TheoreticalTubeLength = ABS(xe-xs)
DBL new_target

;[mm] Tube head position in loader with respect to the head (where to catch)
DBL AcqPosX
DBL Tube_PaddlePos = 850 
DBL CatchVLessZone = 150

IF( %cn[WHO()].rc[0].21 ) RET
IF( %cn[WHO()].pc[14].25 ) RET
IF( %LSRPlcOp0.21 ) RET


IF( %STORE.boolean.0 ) THEN	
   SYN
   MSGOUT "Loader empty, please put tubes in the loader"
   M0
   SYN
   MSGOUT "Press START to continue"
   M0
ENDIF

IF( start_track == 0 ) THEN 

  ;============================================================================
  ;Park all axes to loading quote
  ;============================================================================ 
  
  ; Disable Load
   IF (!%PlcOp0.18) THEN
  
      IF( (tube_len == 0) || ( tube_len >= (%ax30.pa22/1000)) ) THEN 
         SYN
         MSGOUT " Tube length is 0 / exceeds X maximum travel "	   
         M0
         ERROR(793)
      ENDIF

      ;ThreshLoadingSupDown AT %LOADER.values8;  
      ?%LOADER.values8 = NearParkOffset    
   
      ; // Part 1: To initialize loader ***************************************************//
	   JSR "LoadInit.cfs"
  
      ; // Part 2: Positioning Spindles ***************************************************// 
	   JSR "LoadOut.cfs"

      SYN
      IF ((%PROG_ONE.values11) > 6) JMPF((%PROG_ONE.values11))  ; > 6 because 6 is the last checkpoint in LoadOut.cfs
	   
N6
	   
      ; LoadinInProgres          AT %GENERAL_SETUP.values0;
      ?%GENERAL_SETUP.values0 = 1
      
      ; // Part 3: CN8 Request to prepare next tube ***************************************//
      SYN
	   
      IF( %LOADER.boolean.31 ) THEN
         .FAULT_STATE_LOADER_2
         SYN 
         MSGOUT "Loader error / No tubes"	   
         M0
         JMP .FAULT_STATE_LOADER_2	   		   
      ENDIF  
	   
	   %LOADER.boolean.31 = 1                       ; ISO_Loader_Req
	   SYN
	   AWAIT( !%SUPPORTS_SYSTEM.boolean.31 )        ; ISO_SupUn_Init
	   AWAIT( %LOADER.boolean.30 )                  ; ISO_Loader_Ack
	   %LOADER.boolean.30 = 0                       ; ISO_Loader_Ack
	   	   
      SYN
      MSGOUT " Catching Tube ... " 
      
      G153 
      G4010 M(AXIDX(X)) S(AXIDX(3,X)) I1
      G152   
      G4099 
   
	   ; Ensure photocells working well
	   ; I_I_TubeMobile_Spindle AT  %USR_M1.27;
	   ; I_I_TubeFix_Spindle    AT  %USR_M1.28;        ; Not present -> LDN %PLCFLAGS.1 -> ALWAYS_ZERO
	   SYN
	   MSGOUT "Photocell tube detected on spindles" 
	   AWAIT( (!%USR_M1.27) && (!%USR_M1.28) )
       

      ; Based on the theoretical length given by PGM, park unnecessary supports
      ; and move the 1st chuck closer to the tube (assuming it is placed near 
      ; the paddle)
      IF ( Debug_LoadTube == 1) MSGOUT "TheoreticalTubeLength = " TheoreticalTubeLength
      
      IF (TheoreticalTubeLength < (%SUPPORTS_SYSTEM.values3/1000 - %LOADER.values4/1000) ) THEN
      ; Park Support Z4
         IF ( Debug_LoadTube == 1) MSGOUT TheoreticalTubeLength " < " (%SUPPORTS_SYSTEM.values3/1000 - %LOADER.values4/1000)
         IF ( Debug_LoadTube ) M0
         M463
         SYN
         ; I_I_Support_4_Up   AT  %USR_M1.16;
         ; I_I_Support_4_Dwn  AT  %USR_M0.16;
         WAITBIT("%USR_M1.16",0) 
         WAITBIT("%USR_M0.16",1) 

         IF ( Debug_LoadTube ) M0
         ?%M254.3 = 1      ; ParkZ4FromIso
         SYN
         AWAIT( ABS((%ax54.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
         ?%M254.3 = 0      ; ParkZ4FromIso

         IF ( Debug_LoadTube ) M0
         M459                 ; lower v-shape on Z4   
         ;I_I_VshapeZ4_Up     AT  %USR_M49.3;
         ;I_I_VshapeZ4_Dwn    AT  %USR_M49.7;
         WAITBIT("%USR_M49.3",0) 
         WAITBIT("%USR_M49.7",1) 

         IF ( Debug_LoadTube ) M0
         ?%M254.7 = 1        ; ParkO4FromIso
         SYN
         AWAIT( ABS((%ax84.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
         ?%M254.7 = 0        ; ParkO4FromIso

      ENDIF
      IF (TheoreticalTubeLength < (%SUPPORTS_SYSTEM.values2/1000 - %LOADER.values4/1000) ) THEN
      ; Park Support Z3
         IF ( Debug_LoadTube == 1) MSGOUT TheoreticalTubeLength " < " (%SUPPORTS_SYSTEM.values2/1000 - %LOADER.values4/1000)
         IF ( Debug_LoadTube ) M0
         M462
         SYN
         ; I_I_Support_3_Up   AT  %USR_M1.15;
         ; I_I_Support_3_Dwn  AT  %USR_M0.15;
         WAITBIT("%USR_M1.15",0) 
         WAITBIT("%USR_M0.15",1) 

         ?%M254.2 = 1      ; ParkZ3FromIso
         SYN
         AWAIT( ABS((%ax53.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
         ?%M254.2 = 0      ; ParkZ3FromIso

         IF ( Debug_LoadTube ) M0
         M458                 ; lower v-shape on Z3   
         ;I_I_VshapeZ3_Up     AT  %USR_M49.2;
         ;I_I_VshapeZ3_Dwn    AT  %USR_M49.6;
         WAITBIT("%USR_M49.2",0) 
         WAITBIT("%USR_M49.6",1) 
         
         IF ( Debug_LoadTube ) M0
         ?%M254.6 = 1        ; ParkO3FromIso
         SYN
         AWAIT( ABS((%ax83.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
         ?%M254.6 = 0        ; ParkO3FromIso
      ENDIF

      IF (TheoreticalTubeLength < (%SUPPORTS_SYSTEM.values1/1000 - %LOADER.values4/1000) ) ERROR(793)   ; too short

      IF ( Debug_LoadTube ) M0
      G153 G1 X(TheoreticalTubeLength + %LOADER.values4 / 1000 + 500) F10000  

      %PROG_ONE.values11 = 7
N7

	   ; Catch the tube with sensor
	   IF ( Debug_LoadTube ) M0
      SYN
      G153
	   
	   ACCTRJ = 5000
	   DECTRJ = 5000
	   JRKTRJ = 50000
	   
	   ;I_I_TubeMobile_Spindle AT  %USR_M1.27;
	   _singfc( ( Vmax | Vout0 ),X, 2, VHIGH, 0, "%USR_M[1].27", 1 )       	   
	   G4 F0.1
	   SYN
	   AcqPosX = GET(X)
	   G10 G0 X(QCALC(X))			
	   G152	
	   
      %PROG_ONE.values11 = 8
N8
	   
	   SYN	
	   ; Close Spindle Position
	   IF ( Debug_LoadTube ) M0
	   G153 G1 X(QCALC(X) - CatchLoadOft) F10000  	 ; CatchLoadOft: offset between the sensor and the base of the clamps
		 
	   SYN
	   ; New Tube Length = paddle pos + QCALC(X)
	   IF ( Debug_LoadTube ) M0
	   tube_len = QCALC(X) - ( %LOADER.values4 / 1000 )      ; Loader.str -> Loader Paddle Quota [mm]
	   MSGOUT " Tube Length: " tube_len
	   
	   SYN
      IF( tube_len < (ABS(xe-xs) - 100) ) THEN
         SYN 
         MSGOUT " Tube Length >> 100mm shorter than the program, press START to continue "	   
         M0 
      ENDIF  
		 
      ; Close master mobile spindle
      ; I_I_Mobile_Spindle_Close  AT  %USR_M0.28;  
      IF ( Debug_LoadTube ) M0
      M721                             ; Close first spindle 
      G4 F2
       	   
      ; Based on the length of the tube and/or the current position of ax30, 
      ; determine a sequence for switching v-shapes to rollers 

      %PROG_ONE.values11 = 9
N9

      ax30CurrPos = QCALC(X)
      MSGOUT ax30CurrPos
      IF ( Debug_LoadTube ) M0
      ; SUPPORT_1_Quota AT %SUPPORTS_SYSTEM.values0;
      ; SUPPORT_2_Quota AT %SUPPORTS_SYSTEM.values1;
      ; SUPPORT_3_Quota AT %SUPPORTS_SYSTEM.values2;
      ; SUPPORT_4_Quota AT %SUPPORTS_SYSTEM.values3;
      IF (ax30CurrPos > (%SUPPORTS_SYSTEM.values3) / 1000) THEN
      ; Support Z4

         G153
         G4005 S(AXIDX(5,V))		; ungear axis 54
         G152
         G4099

         G153 
         G4010 M(AXIDX(Y)) S(AXIDX(5,V)) I1    ; gear axis 54 (Z4) to 1
         G152   
         G4099 

         IF ( Debug_LoadTube ) M0
         IF ((QCALC(Y) + 50) < (%ax54.pa22/1000))  THEN
         ; Lower axis in order to lower v-shape

            G91 G1 Y(50) F3000         ; lower the support 50mm

            M459                       ; lower v-shape on Z4
            ;I_I_VshapeZ4_Dwn          AT  %USR_M49.7;
            WAITBIT("%USR_M49.7",1) 

            G91 G1 Y(-50) F3000        ; raise the support 50mm

         ELSEIF ((%USR_M1.16) == 1 ) THEN
         ; Lower piston in order to lower v-shape

            M464                       ; piston Z4 down
            ; I_I_Support_4_Dwn        AT  %USR_M0.16;
            WAITBIT("%USR_M0.16",1) 
            
            M459                       ; lower v-shape on Z4
            ;I_I_VshapeZ4_Dwn          AT  %USR_M49.7;
            WAITBIT("%USR_M49.7",1) 

            M736                       ; piston Z4 up
            ; I_I_Support_4_Up         AT  %USR_M1.16;
            WAITBIT("%USR_M1.16",1) 

         ELSE 
            ERROR()     ; Impossible to lower Z4's V-Shape
         ENDIF

         G90 
         G153
         G4005 S(AXIDX(5,V))		; ungear axis 54
         G152
         G4099
      ENDIF
      IF (ax30CurrPos > (%SUPPORTS_SYSTEM.values2) / 1000) THEN
      ; Support Z3
         G153
         G4005 S(AXIDX(5,U))		; ungear axis 53
         G152
         G4099

         G153 
         G4010 M(AXIDX(Y)) S(AXIDX(5,U)) I1    ; gear axis 53 (Z3) to 1
         G152   
         G4099 

         IF ( Debug_LoadTube ) M0
         IF ((QCALC(Y) + 50) < (%ax53.pa22/1000))  THEN
         ; Lower axis in order to lower v-shape

            G91 G1 Y(50) F3000         ; lower the support 50mm

            M458                       ; lower v-shape on Z3
            ;I_I_VshapeZ3_Dwn          AT  %USR_M49.6;
            WAITBIT("%USR_M49.6",1) 

            G91 G1 Y(-50) F3000        ; raise the support 50mm

         ELSEIF ((%USR_M1.15) == 1 ) THEN
         ; Lower piston in order to lower v-shape

            M462                       ; piston Z3 down
            ; I_I_Support_3_Dwn        AT  %USR_M0.15;
            WAITBIT("%USR_M0.15",1) 
            
            M458                       ; lower v-shape on Z3
            ;I_I_VshapeZ3_Dwn          AT  %USR_M49.6;
            WAITBIT("%USR_M49.6",1) 

            M735                       ; piston Z3 up
            ; I_I_Support_3_Up         AT  %USR_M1.15;
            WAITBIT("%USR_M1.15",1) 

         ELSE 
            ERROR()     ; Impossible to lower Z3's V-Shape
         ENDIF
            
         G90
         G153
         G4005 S(AXIDX(5,U))		; ungear axis 53
         G152
         G4099
      ENDIF
      IF (ax30CurrPos > (%SUPPORTS_SYSTEM.values1) / 1000) THEN
      ; Support Z2
         G153
         G4005 S(AXIDX(5,Z))		; ungear axis 52
         G152
         G4099

         G153 
         G4010 M(AXIDX(Y)) S(AXIDX(5,Z)) I1    ; gear axis 52 (Z2) to 1
         G152   
         G4099 

         MSGOUT QCALC(Y)
         IF ( Debug_LoadTube ) M0
         IF ((QCALC(Y) + 50) < (%ax52.pa22/1000))  THEN
         ; Lower axis in order to lower v-shape

            G91 G1 Y(50) F3000         ; lower the support 50mm

            M457                       ; lower v-shape on Z2  
            ;I_I_VshapeZ2_Dwn          AT  %USR_M49.5;
            WAITBIT("%USR_M49.5",1) 

            G91 G1 Y(-50) F3000        ; raise the support 50mm

         ELSEIF ((%USR_M1.14) == 1 ) THEN
         ; Lower piston in order to lower v-shape

            M461                       ; piston Z2 down
            ; I_I_Support_2_Dwn        AT  %USR_M0.14;
            WAITBIT("%USR_M0.14",1) 
            
            M457                       ; lower v-shape on Z2  
            ;I_I_VshapeZ2_Dwn          AT  %USR_M49.5;
            WAITBIT("%USR_M49.5",1) 

            M734                       ; piston Z2 up
            ; I_I_Support_2_Up         AT  %USR_M1.14;
            WAITBIT("%USR_M1.14",1) 

         ELSE 
            ERROR()     ; Impossible to lower Z2's V-Shape
         ENDIF
            
         G90
         G153
         G4005 S(AXIDX(5,Z))		; ungear axis 52
         G152
         G4099
      ENDIF
      IF (ax30CurrPos > (%SUPPORTS_SYSTEM.values0) / 1000) THEN
      ; Support Z1
         G153
         G4005 S(AXIDX(5,Y))		; ungear axis 51
         G152
         G4099

         G153 
         G4010 M(AXIDX(Y)) S(AXIDX(5,Y)) I1    ; gear axis 51 (Z1) to 1
         G152   
         G4099 

         IF ((QCALC(Y) + 50) < (%ax51.pa22/1000))  THEN
         ; Lower axis in order to lower v-shape

            G91 G1 Y(50) F3000         ; lower the support 50mm

            M456                       ; lower v-shape on Z1  
            ;I_I_VshapeZ1_Dwn          AT  %USR_M49.5;
            WAITBIT("%USR_M49.4",1) 

            G91 G1 Y(-50) F3000        ; raise the support 50mm

         ELSEIF ((%USR_M1.13) == 1 ) THEN
         ; Lower piston in order to lower v-shape

            M460                       ; piston Z1 down
            ; I_I_Support_1_Dwn        AT  %USR_M0.13;
            WAITBIT("%USR_M0.13",1) 
            
            M456                       ; lower v-shape on Z1  
            ;I_I_VshapeZ1_Dwn          AT  %USR_M49.4;
            WAITBIT("%USR_M49.4",1) 

            M734                       ; piston Z2 up
            ; I_I_Support_1_Up         AT  %USR_M1.13;
            WAITBIT("%USR_M1.13",1) 

         ELSE 
            ERROR()     ; Impossible to lower Z1's V-Shape 
         ENDIF

         G90
         G153
         G4005 S(AXIDX(5,Y))		; ungear axis 51
         G152
         G4099

      ENDIF

      %PROG_ONE.values11 = 10
N10

      MSGOUT "tube_len = " tube_len
      IF ( Debug_LoadTube ) M0

      new_target = tube_len - %LOADER.values3 / 1000
      MSGOUT "new_target = " new_target
      IF ( Debug_LoadTube ) M0

      IF (new_target < (%SUPPORTS_SYSTEM.values3/1000)) THEN
      ; Park Support Z4
         
         IF ( Debug_LoadTube ) M0
         M463
         SYN
         ; I_I_Support_4_Up   AT  %USR_M1.16;
         ; I_I_Support_4_Dwn  AT  %USR_M0.16;
         WAITBIT("%USR_M1.16",0) 
         WAITBIT("%USR_M0.16",1) 

         IF ( Debug_LoadTube ) M0
         ?%M254.3 = 1      ; ParkZ4FromIso
         SYN
         AWAIT( ABS((%ax54.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
         ?%M254.3 = 0      ; ParkZ4FromIso

         IF ( Debug_LoadTube ) M0
         M459                 ; lower v-shape on Z4   
         ;I_I_VshapeZ4_Up     AT  %USR_M49.3;
         ;I_I_VshapeZ4_Dwn    AT  %USR_M49.7;
         WAITBIT("%USR_M49.3",0) 
         WAITBIT("%USR_M49.7",1) 

         IF ( Debug_LoadTube ) M0
         ?%M254.7 = 1        ; ParkO4FromIso
         SYN
         AWAIT( ABS((%ax84.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
         ?%M254.7 = 0        ; ParkO4FromIso

      ENDIF

      IF (new_target < (%SUPPORTS_SYSTEM.values2/1000)) THEN
      ; Park Support Z3
         
         IF ( Debug_LoadTube ) M0
         ;?%M254.10 = 1        ; ParkPistonZ3FromIso
         M462
         SYN
         ; I_I_Support_3_Up   AT  %USR_M1.15;
         ; I_I_Support_3_Dwn  AT  %USR_M0.15;
         WAITBIT("%USR_M1.15",0) 
         WAITBIT("%USR_M0.15",1) 
         ;?%M254.10 = 0        ; ParkPistonZ3FromIso

         ?%M254.2 = 1      ; ParkZ3FromIso
         SYN
         AWAIT( ABS((%ax53.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
         ?%M254.2 = 0      ; ParkZ3FromIso

         IF ( Debug_LoadTube ) M0
         M458                 ; lower v-shape on Z3   
         ;I_I_VshapeZ3_Up     AT  %USR_M49.2;
         ;I_I_VshapeZ3_Dwn    AT  %USR_M49.6;
         WAITBIT("%USR_M49.2",0) 
         WAITBIT("%USR_M49.6",1) 
         
         IF ( Debug_LoadTube ) M0
         ?%M254.6 = 1        ; ParkO3FromIso
         SYN
         AWAIT( ABS((%ax83.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
         ?%M254.6 = 0        ; ParkO3FromIso
      ENDIF

      IF (new_target < (%SUPPORTS_SYSTEM.values1/1000)) THEN
      ; Park Support Z2
         
         IF ( Debug_LoadTube ) M0
         ;?%M254.10 = 1        ; ParkPistonZ2FromIso
         M461
         SYN
         ; I_I_Support_2_Up   AT  %USR_M1.14;
         ; I_I_Support_2_Dwn  AT  %USR_M0.14;
         WAITBIT("%USR_M1.14",0) 
         WAITBIT("%USR_M0.14",1) 
         ;?%M254.10 = 0        ; ParkPistonZ3FromIso

         ?%M254.1 = 1      ; ParkZ2FromIso
         SYN
         AWAIT( ABS((%ax52.ra4 / 1000) - (%LOADER.values15 / 1000)) < 0.1 )
         ?%M254.1 = 0      ; ParkZ2FromIso

         IF ( Debug_LoadTube ) M0
         M457                 ; lower v-shape on Z2   
         ;I_I_VshapeZ2_Up     AT  %USR_M49.1;
         ;I_I_VshapeZ2_Dwn    AT  %USR_M49.5;
         WAITBIT("%USR_M49.1",0) 
         WAITBIT("%USR_M49.5",1) 
         
         IF ( Debug_LoadTube ) M0
         ?%M254.5 = 1        ; ParkO2FromIso
         SYN
         AWAIT( ABS((%ax82.ra4 / 1000) - (%LOADER.values16 / 1000)) < 0.1 )
         ?%M254.5 = 0        ; ParkO2FromIso
      ENDIF

      %PROG_ONE.values11 = 11
N11
      G153
      G4005 S(AXIDX(3,X))		; ungear axis 30	- X
      G4005 S(AXIDX(3,C))		; ungear axis 34	- Cm
      G152
      G4099
      
      G153 
      G4010 M(AXIDX(X)) S(AXIDX(3,X)) I1    	; gear axis 30 (X) to 0
      G4010 M(AXIDX(C)) S(AXIDX(3,C)) I1    	; gear axis 34 (Cm) to 5
      G152   
      G4099 

      IF ( Debug_LoadTube ) M0  			
      G153 G1 C0 F2000  					
      ; Extra Offset Push Tube More Inside the Machine
      IF ( Debug_LoadTube ) M0 
      G153 G1 X(new_target) F15000       ; %LOADER.values3 : Push Tube More In Machine After Loading [mm]

      G153 
      G4005 S(AXIDX(3,X))
      G4005 S(AXIDX(3,C))	; ungear axis 34
      G152   
      G4099  
      SYN
        
      ; Close Fixed spindle
      IF ( Debug_LoadTube ) M0
	   
	   ; MidSpdOpening  AT  %USR_M41.28;
	   WAITBIT("%USR_M41.28",0)

      ; I_I_FixedSpindle_Close   AT  %USR_M1.31; 
      M982   
      G4 F2
       
      ; Graphic Tube Length Info
      %funz[%IndexORG].origprgX = tube_len
       
	   ;ThreshLoadingSupDown     AT %LOADER.values8;  
      ?%LOADER.values8 = 0
	   
      MSGOUT "Tube Loaded"
  
	   ACCTRJ = %cn[WHO()].pc6			
      DECTRJ = %cn[WHO()].pc7
      JRKTRJ = %cn[WHO()].pc16
	   
	   G153
      IF (AEXISTS(5,Z)) G4005 S(AXIDX(5,Z))
      IF (AEXISTS(5,Y)) G4005 S(AXIDX(5,Y))
      IF (AEXISTS(5,U)) G4005 S(AXIDX(5,U))
      IF (AEXISTS(5,V)) G4005 S(AXIDX(5,V))
      G152
      G4099
  
   ENDIF
ENDIF  
	   
%PROG_ONE.values11 = 0
; LoadinInProgres          AT %GENERAL_SETUP.values0;
?%GENERAL_SETUP.values0 = 0
RET
